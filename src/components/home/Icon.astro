const inner = paths[name] ?? "";
const view = name === "google" ? "0 0 48 48" : "0 0 24 24";
const fill = name === "star" || name === "google" ? "currentColor" : "none";
const stroke = fill === "none" ? "currentColor" : "none";
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={view}
  fill={fill}
  stroke={stroke}
  stroke-width={name === "check" && size <= 14 ? "3" : "1.75"}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
