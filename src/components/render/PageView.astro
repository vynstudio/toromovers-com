---
import React from "react";
import { renderToString } from "react-dom/server";
import Base from "../../layouts/Base.astro";
import "../../app/globals.css";
import { pageLoaders, type PageModule } from "../../lib/page-modules";
import { routeFor } from "../../lib/route-table";
import { resolveHead, type MetaIn } from "../../lib/seo-head";
import { metadata as thanksMetadata } from "../../app/pay/thanks/layout";

interface Props {
  path: string;
  searchParams?: Record<string, string | string[] | undefined>;
  publishableKey?: string;
  checkoutReady?: boolean;
}

const { path, searchParams, publishableKey, checkoutReady } = Astro.props as Props;
const spec = routeFor(path);

if (!spec) {
  Astro.response.status = 404;
}

if (spec && (spec.path === "pay" || spec.path === "pay/thanks")) {
  await import("../../app/pay/pay.css");
}
if (spec?.path === "move-day-checklist") {
  await import("../../app/move-day-checklist/checklist.css");
}

const load = spec ? pageLoaders[spec.key] : undefined;
const mod = load ? ((await load()) as PageModule) : undefined;
const Component = mod?.default;

let rawMeta: unknown = mod?.metadata;
if (!rawMeta && mod?.generateMetadata && spec) {
  const params: Record<string, string> = {};
  if (typeof spec.props.slug === "string") params.slug = spec.props.slug;
  rawMeta = await mod.generateMetadata({ params: Promise.resolve(params) });
}
if (spec?.path === "pay/thanks") rawMeta = thanksMetadata;

const head = resolveHead((rawMeta || {}) as MetaIn);
const pageProps: Record<string, unknown> = { ...spec?.props };
if (spec?.path === "pay") {
  pageProps.searchParams = searchParams || {};
  pageProps.publishableKey = publishableKey || "";
  pageProps.checkoutReady = Boolean(checkoutReady);
}

let inner = "";
if (Component) {
  inner = renderToString(React.createElement(Component as never, pageProps));
}
const preloads = [...inner.matchAll(/<link\b[^>]*rel="preload"[^>]*>/gi)].map((match) => match[0]);
const pageKey = spec?.key || "";
---

<Base title={head.title} tags={head.tags} preloads={preloads}>
  <div id="app" class="contents">
    <Fragment set:html={inner} />
  </div>
  {
    pageKey ? (
      <>
        <script is:inline define:vars={{ pageKey, pageProps }}>
          window.__TORO_PAGE__ = { pageKey, pageProps };
        </script>
        <script>
          import { hydratePage } from "../../lib/hydrate-client";
          const boot = () => {
            const data = window.__TORO_PAGE__;
            if (!data?.pageKey) return;
            hydratePage(data.pageKey, data.pageProps || {});
          };
          const start = () => {
            if ("requestIdleCallback" in window) {
              window.requestIdleCallback(() => boot(), { timeout: 1800 });
            } else {
              boot();
            }
          };
          if (document.readyState === "complete") start();
          else window.addEventListener("load", start, { once: true });
        </script>
      </>
    ) : null
  }
</Base>
