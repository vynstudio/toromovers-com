---
import React from "react";
import { renderToString } from "react-dom/server";
import Base from "../../layouts/Base.astro";
import "../../app/globals.css";
import { pageLoaders, type PageModule } from "../../lib/page-modules";
import { routeFor } from "../../lib/route-table";
import { resolveHead, type MetaIn } from "../../lib/seo-head";
import { metadata as thanksMetadata } from "../../app/pay/thanks/layout";

import Hydrate from "./Hydrate.astro";
import LpFooter from "../chrome/LpFooter.astro";
import LpHeader from "../chrome/LpHeader.astro";
import SiteFooter from "../chrome/SiteFooter.astro";
import SiteNav from "../chrome/SiteNav.astro";
import checklistCss from "../../app/move-day-checklist/checklist.css?url";
import payCss from "../../app/pay/pay.css?url";
import quotesCss from "../../styles/quotes-rebrand.css?url";
import contactCss from "../../styles/contact-rebrand.css?url";
import lpLocalCss from "../../styles/lp-local-rebrand.css?url";
import thanksCss from "../../styles/thank-you-rebrand.css?url";
import servicesCss from "../../styles/services-rebrand.css?url";
import fullServiceCss from "../../styles/full-service-rebrand.css?url";
import grotesk400 from "@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url";
import grotesk600 from "@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url";
import { PHONE_E164, PHONE_TEL, SITE_URL } from "../../lib/site.ts";

interface Props {
  path: string;
  searchParams?: Record<string, string | string[] | undefined>;
  publishableKey?: string;
  checkoutReady?: boolean;
  /** Homepage renders static HTML. Other routes still hydrate the page. */
  hydrate?: boolean;
}

const { path, searchParams, publishableKey, checkoutReady, hydrate = true } =
  Astro.props as Props;
const spec = routeFor(path);

if (!spec) {
  Astro.response.status = 404;
}

const load = spec ? pageLoaders[spec.key] : undefined;
const mod = load ? ((await load()) as PageModule) : undefined;
const Component = mod?.default;

let rawMeta: unknown = mod?.metadata;
if (!rawMeta && mod?.generateMetadata && spec) {
  const params: Record<string, string> = {};
  if (typeof spec.props.slug === "string") params.slug = spec.props.slug;
  rawMeta = await mod.generateMetadata({ params: Promise.resolve(params) });
}
if (spec?.path === "pay/thanks") rawMeta = thanksMetadata;

const head = resolveHead((rawMeta || {}) as MetaIn);
const pageProps: Record<string, unknown> = { ...spec?.props };
if (spec?.path === "pay") {
  pageProps.searchParams = searchParams || {};
  pageProps.publishableKey = publishableKey || "";
  pageProps.checkoutReady = Boolean(checkoutReady);
}

let inner = "";
if (Component) {
  inner = renderToString(React.createElement(Component as never, pageProps));
}
const HERO_SRCSET =
  "/images/hero-video-poster-640.webp 640w, /images/hero-video-poster-960.webp 960w, /images/hero-video-poster.webp 1280w";

function normalizePreload(tag: string) {
  let out = tag.replace(/\bfetchPriority=/g, "fetchpriority=");
  if (out.includes("/images/hero-video-poster.webp") && !out.includes("imagesrcset=")) {
    out = out.replace(
      /^<link\s+/i,
      `<link imagesrcset="${HERO_SRCSET}" imagesizes="100vw" `,
    );
  }
  if (out.includes("hero-video-poster") && !/fetchpriority=/i.test(out)) {
    out = out.replace(/^<link\s+/i, '<link fetchpriority="high" ');
  }
  return out;
}

const seenPreload = new Set<string>();
const preloads = [...inner.matchAll(/<link\b[^>]*rel="preload"[^>]*>/gi)]
  .map((match) => normalizePreload(match[0]))
  .filter((tag) => {
    const href = (tag.match(/\bhref="([^"]+)"/i) || [])[1] || tag;
    if (seenPreload.has(href)) return false;
    seenPreload.add(href);
    return true;
  });
inner = inner.replace(/<link\b[^>]*rel="preload"[^>]*>/gi, "").trim();
const isFullService = spec?.path === "full-service-moving";
const isLaborOnly = spec?.path === "labor-only-moving";
const isApartment = spec?.path === "apartment-movers-orlando-fl";
const isLoading = spec?.path === "loading-unloading";
const isPacking = spec?.path === "packing-services-orlando";
const isOffice = spec?.path === "office-movers-orlando";
const isSameDay = spec?.path === "same-day-movers-orlando";
const isSmallMoves = spec?.path === "small-moves-orlando";
const isPodLoading = spec?.path === "pod-loading-orlando";
if (isFullService || isLaborOnly || isApartment || isLoading || isPacking || isOffice || isSameDay || isSmallMoves || isPodLoading) {
  for (const href of [grotesk400, grotesk600]) {
    if (seenPreload.has(href)) continue;
    seenPreload.add(href);
    preloads.push(
      `<link rel="preload" href="${href}" as="font" type="font/woff2" crossorigin="anonymous" />`,
    );
  }
}
const pageKey = spec?.key || "";
const isQuotes = spec?.path === "quotes";
const isContact = spec?.path === "contact";
const isLpLocal = spec?.path === "lp/local-movers";
const isThankYou = spec?.path === "thank-you";
const isServices = spec?.path === "services";
const isRebrandChrome =
  isQuotes || isContact || isServices || isFullService || isLaborOnly || isApartment || isLoading || isPacking || isOffice || isSameDay || isSmallMoves || isPodLoading;
const LOCAL_PHONE = "321-234-0510";
---

<Base
  title={head.title}
  tags={head.tags}
  preloads={preloads}
  deferTrackers={!hydrate}
  businessTelephone={isRebrandChrome || isLpLocal || isThankYou ? PHONE_E164 : undefined}
  businessImage={
    isThankYou || isServices || isFullService || isLaborOnly || isApartment || isLoading || isPacking || isOffice || isSameDay || isSmallMoves || isPodLoading
      ? `${SITE_URL}/images/pay-confirm-family.webp`
      : undefined
  }
  omitPriceRange={
    isThankYou || isServices || isFullService || isLaborOnly || isApartment || isLoading || isPacking || isOffice || isSameDay || isSmallMoves || isPodLoading
  }
  extraCss={
    spec?.path === "move-day-checklist"
      ? [checklistCss]
      : spec?.path === "pay" || spec?.path === "pay/thanks"
        ? [payCss]
        : isQuotes
          ? [quotesCss]
          : isContact
            ? [contactCss]
            : isLpLocal
              ? [lpLocalCss]
              : isThankYou
                ? [thanksCss]
                : isServices
                  ? [servicesCss]
                  : isFullService || isLaborOnly || isApartment || isLoading || isPacking || isOffice || isSameDay || isSmallMoves || isPodLoading
                    ? [fullServiceCss]
                    : []
  }
>
  {
    isRebrandChrome ? (
      <SiteNav
        phoneDisplay={LOCAL_PHONE}
        phoneTel={PHONE_TEL}
        quoteHref={isContact ? "#quote" : "#quote-form"}
        sectionPrefix="/"
      />
    ) : isLpLocal ? (
      <LpHeader phoneDisplay={LOCAL_PHONE} phoneTel={PHONE_TEL} logoHref="#quote-form" />
    ) : null
  }
  <div id="app" class="contents" set:html={inner} />
  {isRebrandChrome ? (
    <SiteFooter
      phoneDisplay={LOCAL_PHONE}
      phoneTel={PHONE_TEL}
      quoteHref={isContact ? "#quote" : "#quote-form"}
    />
  ) : isLpLocal ? (
    <LpFooter phoneDisplay={LOCAL_PHONE} phoneTel={PHONE_TEL} />
  ) : null}
  {hydrate && pageKey ? <Hydrate pageKey={pageKey} pageProps={pageProps} /> : null}
</Base>
