---
interface Props {
  phoneDisplay?: string;
  phoneTel?: string;
}

const {
  phoneDisplay = "321-234-0510",
  phoneTel = "tel:+13212340510",
} = Astro.props;
---

<footer class="lp-foot">
  <div class="container lp-foot-in">
    <a href={phoneTel} data-track="phone">Call {phoneDisplay}</a>
    <p>© 2026 Toro Movers</p>
    <nav aria-label="Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/cookies">Cookie Policy</a>
      <a href="/terms">Terms of Service</a>
    </nav>
  </div>
</footer>
