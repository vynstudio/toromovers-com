---
import Icon from "../home/Icon.astro";
import {
  HOME_PHONE_DISPLAY,
  HOME_PHONE_TEL,
  NATIONWIDE_HREF,
} from "../../lib/site-chrome.ts";

interface Props {
  phoneDisplay?: string;
  phoneTel?: string;
  quoteHref?: string;
  /** "" on the homepage. "/" so section links leave this page for the homepage. */
  sectionPrefix?: string;
}

const {
  phoneDisplay = HOME_PHONE_DISPLAY,
  phoneTel = HOME_PHONE_TEL,
  quoteHref = "#quote",
  sectionPrefix = "",
} = Astro.props;
---

<header class="nav nav-c">
  <div class="container nav-in">
    <a href="/" class="logo logo-img" aria-label="Toro Movers home"><img src="/logos/toro-lockup-navy.svg" alt="Toro Movers" width="200" height="50" /></a>
    <nav class="nav-links" aria-label="Primary">
      <a href={`${sectionPrefix}#services`}>Services</a>
      <a href={`${sectionPrefix}#areas`}>Service Areas</a>
      <a href={NATIONWIDE_HREF}>Nationwide</a>
      <a href={`${sectionPrefix}#guides`}>Guides</a>
    </nav>
    <div class="nav-cta">
      <a class="nav-phone" href={phoneTel} data-track="phone" aria-label={`Call ${phoneDisplay}`}>
        <Icon name="phone" size={18} />
        <span>{phoneDisplay}</span>
      </a>
      <a href={quoteHref} class="btn btn-red btn-sm" data-text="Get a Quote" data-track="quote">
        <span>Get a Quote</span>
      </a>
      <button class="nav-burger" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
  <nav id="nav-panel" class="nav-panel" aria-label="Mobile">
    <a href={`${sectionPrefix}#services`}>Services</a>
    <a href={`${sectionPrefix}#areas`}>Service Areas</a>
    <a href={NATIONWIDE_HREF}>Nationwide</a>
    <a href={`${sectionPrefix}#guides`}>Guides</a>
    <a href={quoteHref} data-track="quote">Get a Quote</a>
  </nav>
</header>
<script>
  const header = document.querySelector(".nav-c");
  const burger = document.querySelector(".nav-burger");
  burger?.addEventListener("click", () => {
    const open = header?.classList.toggle("is-open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });
  document.querySelectorAll(".nav-panel a").forEach((link) => {
    link.addEventListener("click", () => {
      header?.classList.remove("is-open");
      burger?.setAttribute("aria-expanded", "false");
    });
  });
</script>
