---
import Icon from "../home/Icon.astro";
import {
  HOME_PHONE_DISPLAY,
  HOME_PHONE_TEL,
  NATIONWIDE_HREF,
} from "../../lib/site-chrome.ts";
---

<div class="topbar">
  <div class="container topbar-in">
    <span><Icon name="star" size={14} /> 5.0 on Google</span>
    <span><Icon name="languages" size={14} /> English & Spanish</span>
    <span class="tb-hide"><Icon name="clock" size={14} /> 2-hour minimum</span>
    <a href={HOME_PHONE_TEL} data-track="phone">
      <Icon name="phone" size={14} />
      {HOME_PHONE_DISPLAY}
    </a>
  </div>
</div>
<header class="nav nav-c">
  <div class="container nav-in">
    <a href="/" class="logo"><span class="logo-mark">TORO</span><span class="logo-sub">MOVERS</span></a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#services">Services</a>
      <a href="#areas">Service Areas</a>
      <a href={NATIONWIDE_HREF}>Nationwide</a>
      <a href="#guides">Guides</a>
    </nav>
    <div class="nav-cta">
      <a class="nav-phone" href={HOME_PHONE_TEL} data-track="phone" aria-label={`Call ${HOME_PHONE_DISPLAY}`}>
        <Icon name="phone" size={18} />
        <span>{HOME_PHONE_DISPLAY}</span>
      </a>
      <a href="#quote" class="btn btn-red btn-sm" data-text="Get a Quote" data-track="quote">
        <span>Get a Quote</span>
      </a>
      <button class="nav-burger" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
  <nav id="nav-panel" class="nav-panel" aria-label="Mobile">
    <a href="#services">Services</a>
    <a href="#areas">Service Areas</a>
    <a href={NATIONWIDE_HREF}>Nationwide</a>
    <a href="#guides">Guides</a>
    <a href="#quote" data-track="quote">Get a Quote</a>
  </nav>
</header>
<script>
  const header = document.querySelector(".nav-c");
  const burger = document.querySelector(".nav-burger");
  burger?.addEventListener("click", () => {
    const open = header?.classList.toggle("is-open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });
  document.querySelectorAll(".nav-panel a").forEach((link) => {
    link.addEventListener("click", () => {
      header?.classList.remove("is-open");
      burger?.setAttribute("aria-expanded", "false");
    });
  });
</script>
