---
import Base from "../layouts/Base.astro";
import { resolveHead } from "../lib/seo-head";

const head = resolveHead({});
Astro.response.status = 404;
---

<Base
  title={head.title}
  tags={head.tags}
  leadingTitle="404: This page could not be found."
  leadingRobots="noindex"
>
  <div
    style="font-family:system-ui,'Segoe UI',Roboto,Helvetica,Arial,sans-serif,'Apple Color Emoji','Segoe UI Emoji';height:100vh;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center"
  >
    <div>
      <h1
        class="next-error-h1"
        style="display:inline-block;margin:0 20px 0 0;padding:0 23px 0 0;font-size:24px;font-weight:500;vertical-align:top;line-height:49px"
      >
        404
      </h1>
      <div style="display:inline-block">
        <h2 style="font-size:14px;font-weight:400;line-height:49px;margin:0">
          This page could not be found.
        </h2>
      </div>
    </div>
  </div>
</Base>
