# Site
NEXT_PUBLIC_SITE_URL=https://toromovers.com

# --- Lead notifications (required for quote form delivery) ---

# Internal alert — Telegram (you)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Client SMS — OpenPhone / Quo (from business number)
OPENPHONE_API_KEY=
OPENPHONE_FROM_NUMBER=+16896002720
OPENPHONE_PHONE_NUMBER_ID=
# Svix-style signing secret from POST /v1/webhooks/call-summaries (whsec_…)
QUO_WEBHOOK_KEY=
# Legacy OpenPhone header, if an older webhook still sends it
OPENPHONE_WEBHOOK_SECRET=
# Missed-call SMS is off until compliance is approved in writing
OPENPHONE_MISSED_CALL_SMS=false
QUO_REPORT_SECRET=

# Client email — Resend (must be from hello@toromovers.com once domain verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@toromovers.com

# Optional: also push into toromovers.net CRM / HubSpot
LEAD_FORWARD_URL=https://toromovers.net/api/crm/lead
LEAD_INTAKE_SECRET=

# Stripe — deposits, full payments, and crew tips at /pay (Embedded Checkout)
# Dashboard: https://dashboard.stripe.com/apikeys
# Use a restricted key with Checkout Sessions + Webhooks, not the full sk_live if possible.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
