# Site
NEXT_PUBLIC_SITE_URL=https://toromovers.com

# --- Lead notifications (required for quote form delivery) ---

# Internal alert — Telegram (you)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Client SMS — Quo (optional). Team alerts are Telegram only; do not SMS LEAD_SMS_TO.
# HTTP 401 on client SMS means rotate QUO_API_KEY in Netlify. Do not commit the key.
QUO_API_KEY=
QUO_FROM_NUMBER=+16896002720
# QUO_FROM_PHONE_NUMBER_ID=PN3sKfvpYp
# LEAD_SMS_TO is unused (team = Telegram). Left here so existing Netlify env is a no-op.
# LEAD_SMS_TO=+13217580094
# OPENPHONE_API_KEY=
# OPENPHONE_FROM_NUMBER=+16896002720

# Client confirmation email — Resend
# Current verified in Resend: hello@toromovers.net
# hello@toromovers.com returns HTTP 403 until toromovers.com is verified.
# Switch to hello@toromovers.com ONLY after that domain is verified in Resend.
# Env-driven only — the app never hardcodes from.
# Bare address only. The app wraps once as `Toro Movers <that-address>`.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@toromovers.net

# Optional: also push into toromovers.net CRM / HubSpot
LEAD_FORWARD_URL=https://toromovers.net/api/crm/lead
LEAD_INTAKE_SECRET=

# Stripe — deposits, remaining balance, and crew tips at /pay (Embedded Checkout)
# Dashboard: https://dashboard.stripe.com/apikeys
# Use a restricted key with Checkout Sessions + Webhooks, not the full sk_live if possible.
# Publishable + secret must be the same mode (both live or both test).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional stable secret for signed quote PDF links (`scripts/quote-pay-link.mjs`).
# If unset, quote tokens fall back to STRIPE_SECRET_KEY — rotating Stripe keys then invalidates PDFs.
QUOTE_PAY_SECRET=
