# Site
NEXT_PUBLIC_SITE_URL=https://toromovers.com

# --- Lead notifications (required for quote form delivery) ---

# Internal alert — Telegram (you)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Team + client SMS — Quo (required for live send from /get-my-price)
# If QUO_API_KEY is missing, leads are still accepted; SMS is skipped and logged.
# Netlify: Site settings → Environment variables → add QUO_API_KEY (from Quo API).
QUO_API_KEY=
QUO_FROM_NUMBER=+16896002720
LEAD_SMS_TO=+13217580094
# Optional aliases (same Quo key). Prefer QUO_* above.
# OPENPHONE_API_KEY=
# OPENPHONE_FROM_NUMBER=+16896002720

# Client email — Resend (must be from hello@toromovers.com once domain verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@toromovers.com

# Optional: also push into toromovers.net CRM / HubSpot
LEAD_FORWARD_URL=https://toromovers.net/api/crm/lead
LEAD_INTAKE_SECRET=

# Stripe — deposits, remaining balance, and crew tips at /pay (Embedded Checkout)
# Dashboard: https://dashboard.stripe.com/apikeys
# Required. Publishable + secret must be the same mode (both live or both test).
# There is no committed pk_live_ fallback — /pay will not start Checkout without these.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional stable secret for signed quote PDF links (`scripts/quote-pay-link.mjs`).
# If unset, quote tokens fall back to STRIPE_SECRET_KEY — rotating Stripe keys then invalidates PDFs.
QUOTE_PAY_SECRET=
